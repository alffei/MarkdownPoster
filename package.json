{
  "name": "markdownposter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "vite build --configLoader native",
    "preview": "vite preview --configLoader native",
    "check:comment-only": "node scripts/check-comment-only.mjs --base HEAD",
    "check:comment-only:relaxed": "node scripts/check-comment-only.mjs --base HEAD --allow-new-files",
    "guard:comment": "bash scripts/comment-guard.sh HEAD"
  },
  "dependencies": {
    "katex": "^0.16.27",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "@google/genai": "^1.33.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-directive": "^3.0.0",
    "rehype-katex": "^7.0.0",
    "unist-util-visit": "^5.0.0",
    "html-to-image": "1.11.11",
    "jszip": "3.10.1",
    "file-saver": "2.0.5",
    "prism-react-renderer": "^2.4.1",
    "js-yaml": "4.1.0",
    "react-zoom-pan-pinch": "3.4.4"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
